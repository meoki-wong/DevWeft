# Standby node settings. Copy this file to data/node.env and replace the placeholders.
NODE_ENV=production
PORT=8791
AWP_DB_DIALECT=postgres
AWP_PG_URL=postgresql://USER:PASSWORD@PRIMARY_HOST:5432/DATABASE
# Optional explicit override. If blank, the standby uses the non-loopback
# primary link configured in the dashboard and stored in the shared database.
# For failover tests, prefer the primary's independent blob endpoint, usually :8792.
AWP_BLOB_BASE_URL=
AWP_STANDBY=1
