AWP_DB_DIALECT=sqlite
# PostgreSQL 15+ is optional. For an external/shared database, set AWP_DB_DIALECT=postgres,
# AWP_PG_MODE=external, and a reachable, initialized AWP_PG_URL.
# For a single Windows host, set AWP_DB_DIALECT=postgres and AWP_PG_MODE=embedded;
# deploy.cmd initializes the bundled local PostgreSQL cluster and schema.
AWP_PG_MODE=external
# AWP_PG_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional local PostgreSQL settings for embedded mode.
# AWP_PG_DATA_DIR=data/pgdata
# AWP_PG_PORT=5432
# AWP_PG_DATABASE=awp_platform
AWP_CONTROL_PORT=8791
AWP_GATEWAY_PORT=8787
AWP_BLOB_PORT=8792
# Optional authoritative artifact directory shared by the control plane and blob service.
# AWP_BLOB_ROOT=data/blobs
AWP_BROKER_PORT=8788
# Optional runner directory and Git remote to register during bootstrap.
# AWP_RUNNER_ROOT=data/runner
# AWP_GIT_REMOTE_URL=https://github.com/your-org/your-repo.git
# Optional Ed25519 signing-key directory (defaults to ignored data/signing-keys).
# AWP_SIGNING_KEY_DIR=data/signing-keys
# Hyper-V is opt-in. The control plane works without Windows or a VM image.
AWP_HYPERV_ENABLED=false
# Runner backend: hyperv (VM isolation, requires Hyper-V opt-in) or local (static runs, no VM isolation).
# AWP_RUNNER_BACKEND=local
# Optional RFC1918 /24. .1 is the proxy, .10 is the default guest, .11-.26 are parallel guests.
AWP_VM_NETWORK_CIDR=192.168.250.0/24
# Optional Hyper-V internal switch name.
AWP_VM_SWITCH_NAME=awp-isolated
# Example project workspace. Configure one variable per repository slug.
# AWP_REPO_PATH_EXAMPLE_APP=C:\repos\example-app
