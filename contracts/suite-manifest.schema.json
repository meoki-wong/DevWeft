{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.invalid/contracts/suite-manifest.schema.json",
  "title": "SuiteRevisionManifest",
  "description": "suite_revisions.manifest_json. Each case must include caseKey/title/tags/protected/replacesCaseKey/requiredCapabilities. Candidate create requests reuse files[] with relative path + sha256 + utf8 content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "requiredCapabilities", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "requiredCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "files": {
      "type": "array",
      "description": "Present on candidate create manifests. Allowed prefixes: specs/, fixtures/, mocks/, or exact manifest.json.",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseKey",
        "title",
        "tags",
        "protected",
        "replacesCaseKey",
        "requiredCapabilities"
      ],
      "properties": {
        "caseKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "protected": { "type": "boolean" },
        "replacesCaseKey": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "requiredCapabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(specs/|fixtures/|mocks/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$|^manifest\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string" }
      }
    }
  }
}
