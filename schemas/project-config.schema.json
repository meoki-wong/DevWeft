{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/meoki-wong/DevWeft/main/schemas/project-config.schema.json",
  "title": "DevWeft Project Configuration",
  "description": "Portable per-project checks and context settings. Commands are argument vectors and are never joined into a shell string.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/meoki-wong/DevWeft/main/schemas/project-config.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "skills": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acTemplate": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/check"
      }
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    }
  }
}
